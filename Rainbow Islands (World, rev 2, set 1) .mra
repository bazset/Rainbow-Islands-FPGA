<!--
Rainbow Islands (Taito, 1987)

Requires both rbisland.zip and cchip.zip. The C chip's 4KB internal mask ROM
(cchip_upd78c11.bin) is a shared MAME device ROM and lives in cchip.zip; the
8KB game specific EPROM (cchip_b22-15.53) is inside rbisland.zip.

All regions are concatenated into a single stream that the core splits by
address:

    0x000000  68000 program    512KB
    0x080000  Z80 program      112KB
    0x09C000  PC080SN tiles    512KB
    0x11C000  PC090OJ sprites  640KB
    0x1BC000  C chip ROMs      12KB
    0x1BF000  YM script blob   512KB  (generated, embedded below)

The sound build's audio is NOT in this stream. It is baked into the .rbf itself
(SCRIPTS_EMBEDDED=1 in rbisland_top.sv, initialised from sound/rbisland_ym.hex
at synthesis time), so there is no sound part here and no extra zip to install.
The same .mra works for either build: an embedded core ignores a sound region
if one is present.

The Z80 program is still loaded even though the sound build does not
instantiate a Z80. Keeping it in the stream keeps every offset after it exactly
where it is, so returning to the real Z80 needs no change here.

ROM names, CRCs and DIP definitions follow MAME's src/mame/taito/rbisland.cpp
and src/mame/taito/taitocchip.cpp.
-->
<misterromdescription>
    <rbf>Rbisland</rbf>
    <name>Rainbow Islands (World, rev 2, set 1)</name>
    <setname>rbisland</setname>
    <year>1987</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <joystick>2way</joystick>
    <rotation>horizontal</rotation>
    <region>World</region>

    <rom index="0" zip="rbisland.zip|cchip.zip" type="merged" md5="none">

        <!-- 68000 program. Even offset takes the high byte of each word. -->
        <interleave output="16">
            <part name="b22-10-1.19" crc="e34a50ca" map="01"/>
            <part name="b22-11-1.20" crc="6a31a093" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b22-08-1.21" crc="15d6e17a" map="01"/>
            <part name="b22-09-1.22" crc="454e66bc" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b22-03.23" crc="3ebb0fb8" map="01"/>
            <part name="b22-04.24" crc="91625e7f" map="10"/>
        </interleave>

        <!-- Z80 program. One 64KB chip split either side of a 0xC000 gap.
             The gap is filled with 00 because sound bank 0 maps onto its
             tail, and 00 is NOP on a Z80 where FF would be RST 38h. -->
        <part name="b22-14.43" crc="113c1a5b" offset="0" length="0x4000"/>
        <part repeat="0xC000">00</part>
        <part name="b22-14.43" crc="113c1a5b" offset="0x4000" length="0xC000"/>

        <!-- PC080SN tiles, delivered raw. The word byte swap MAME applies
             with ROM_LOAD16_WORD_SWAP is performed in the core instead. -->
        <part name="b22-01.2" crc="b76c9168"/>

        <!-- PC090OJ sprites. Only the first 512KB is word swapped in MAME;
             the final 128KB is a plain even/odd interleave. -->
        <part name="b22-02.5" crc="1b87ecf0"/>
        <interleave output="16">
            <part name="b22-13.6" crc="2fda099f" map="01"/>
            <part name="b22-12.7" crc="67a76dc6" map="10"/>
        </interleave>

        <!-- C chip: internal mask ROM then game specific EPROM. -->
        <part name="cchip_upd78c11.bin" crc="43021521"/>
        <part name="cchip_b22-15.53" crc="08c588a6"/>

        <!-- YM2151 script blob - the complete captured soundtrack, 27 sound
             effects and 50 music tracks at full length. Generated by
             tools/build_sound_scripts.py from MAME register captures; not a
             PCB ROM. Embedded inline rather than shipped as a separate zip so
             there is nothing extra to install.

             It is here and not in the .rbf because it does not fit on the
             FPGA: 474.7KB as a byte-wide on-chip memory is ~380 M10K blocks
             on top of the ~365 the rest of the core needs, against a device
             total of 553. It lives in SDRAM (byte 0x300000) instead. -->
        <part>
08 04 00 00 F5 6A 07 00 7A 10 01 60 32 0A 01 00 7D 09 01 00 17 52 00 00 93 70 01 00 62 C6 01 00
E5 75 00 20 E5 A6 01 00 F7 A2 05 20 6A A2 04 20 3C F6 02 20 7F 3C 01 00 14 77 02 00 16 22 05 20
