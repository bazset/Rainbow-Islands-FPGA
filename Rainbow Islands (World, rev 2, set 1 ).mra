<!--
Rainbow Islands (Taito, 1987) -- Arcade-Rbisland_MiSTer

ROM regions, CRCs, and DIP switch definitions confirmed directly from
MAME's src/mame/taito/rbisland.cpp (ROM_START(rbisland), rbisland_generic
INPUT_PORTS) and src/mame/taito/taitocchip.cpp (the shared C-chip mask
ROM). This is the "World, rev 2, set 1" set specifically -- rbislando
and rbislande use different maincpu/cchip_eprom dumps not covered here.

Uses 5 separate <rom index> blocks matching this project's ioctl_index
convention (IDX_MAIN=0, IDX_SND=1, IDX_GFX=2, IDX_OBJ=3, IDX_CCHIP=4 --
see rbisland_top.sv), NOT a single combined PROM stream the way some
other Taito-family FPGA cores (e.g. jotego/JTFRAME-based ones) do it.

Two things flagged as not independently validated against a real
MiSTer setup (no way to test that in this environment):
  - The Z80 sound ROM's internal padding layout (see the IDX_SND block's
    own comment) -- the BYTE COUNTS are confirmed from source, but the
    exact <part offset=".." length=".."> attribute syntax for reading a
    subset of the same file twice was not confirmed against a working
    example; double-check this block specifically if the Z80 doesn't
    boot.
  - The DIP switch <switches> bit numbering/ids below follow the same
    format as a confirmed-working reference .mra (see
    doc/rainbow_islands_notes.md), but weren't tested against this
    project's own actual dswa_din/dswb_din wiring in rbisland_top.sv
    (which still needs updating to read real status[] bits -- see that
    file's own TODO).
-->
<misterromdescription>
    <rbf>rbisland</rbf>
    <name>Rainbow Islands (World, rev 2, set 1)</name>
    <setname>rbisland</setname>
    <year>1987</year>
    <manufacturer>Taito</manufacturer>
    <players>2</players>
    <joystick>2way</joystick>
    <buttons>2</buttons>
    <rotation>vertical</rotation>

    <!-- IDX_MAIN (index 0): 68000 program, 512KB, byte-interleaved from
         6 files (3 even/odd pairs at 0x00000/0x20000/0x40000) -->
    <rom index="0">
        <interleave output="16">
            <part name="b22-10-1.19" crc="e34a50ca" map="01"/>
            <part name="b22-11-1.20" crc="6a31a093" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b22-08-1.21" crc="15d6e17a" map="01"/>
            <part name="b22-09-1.22" crc="454e66bc" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="b22-03.23" crc="3ebb0fb8" map="01"/>
            <part name="b22-04.24" crc="91625e7f" map="10"/>
        </interleave>
    </rom>

    <!-- IDX_SND (index 1): Z80 sound program, 0x1C000 (112KB) total,
         matching rbisland_top.sv's z80_rom_mem sizing/addressing
         exactly. b22-14.43 is a single 64KB physical chip loaded in two
         pieces in the original (ROM_LOAD 0x4000 bytes, then
         ROM_CONTINUE 0xC000 bytes at region offset 0x10000) -- the
         0x8000 gap between them (region 0x4000-0xBFFF) and the first
         0x4000 of the banked window (0xC000-0xFFFF, MAME's own bank 0,
         which is never actually populated by either ROM_LOAD directive)
         are both padding, not real code. See this file's header note on
         the offset/length syntax below not being independently
         confirmed. -->
    <rom index="1">
        <part name="b22-14.43" crc="113c1a5b" offset="0" length="0x4000"/>
        <part repeat="0xC000">FF</part>
        <part name="b22-14.43" crc="113c1a5b" offset="0x4000" length="0xC000"/>
    </rom>

    <!-- IDX_GFX (index 2): PC080SN tile ROM, 512KB -->
    <rom index="2">
        <part name="b22-01.2" crc="b76c9168"/>
    </rom>

    <!-- IDX_OBJ (index 3): PC090OJ sprite ROM, 0xA0000 (640KB) --
         512KB word-swapped part + 128KB byte-interleaved part -->
    <rom index="3">
        <part name="b22-02.5" crc="1b87ecf0"/>
        <interleave output="16">
            <part name="b22-13.6" crc="2fda099f" map="01"/>
            <part name="b22-12.7" crc="67a76dc6" map="10"/>
        </interleave>
    </rom>

    <!-- IDX_CCHIP (index 4): C-chip ROM, 0x3000 (12KB) contiguous --
         4KB shared internal mask ROM (same file across every C-chip
         game, confirmed from taitocchip.cpp's own device ROM_START,
         NOT specific to Rainbow Islands -- lives in a separate
         "cchip.zip", hence the multi-zip merge below) directly followed
         by the 8KB game-specific external EPROM. No gap: this matches
         rbisland_cchip.sv's own contiguous mask+eprom loading, NOT
         MAME's internal 16KB-with-a-4KB-gap region layout (that gap
         only exists inside MAME's own uPD78C11 address space
         representation, not in how this project stores the ROM data). -->
    <rom index="4" zip="rbisland.zip|cchip.zip" type="merged" md5="none">
        <part name="cchip_upd78c11.bin" crc="43021521"/>
        <part name="cchip_b22-15.53" crc="08c588a6"/>
    </rom>

    <!-- DSWA/DSWB confirmed from rbisland_generic's INPUT_PORTS and the
         shared TAITO_MACHINE_COCKTAIL/TAITO_DSWA_BITS_2_TO_3/
         TAITO_DIFFICULTY macros (src/mame/taito/taitoipt.h).
         default="fe,bf" is computed bit-by-bit from each PORT_DIPNAME's
         own stated default value (Cabinet=Upright/0, Flip=Off/1,
         Service=inactive/1, Demo=On/1, Coin_A=0x30, Coin_B=0xc0 -> DSWA
         0xFE; Difficulty=Medium/0x03, Bonus=100k1000k/1, Complete=1Up/1,
         Lives=3/0x30, Language=English/0, Coin Mode=Mode A(Japan)/1 ->
         DSWB 0xBF) -- NOT copied from an unrelated reference file.
         Coin_A/Coin_B option labels below use the "Mode A (Japan)"
         coinage table specifically, because that IS this game's actual
         default Coin Mode value per source (0x80/"Mode A" is the
         PORT_DIPNAME default, somewhat counterintuitively for a "World"
         program ROM) -- MiSTer's DIP UI can't conditionally relabel
         Coin_A/Coin_B based on another switch's value the way the real
         cabinet's manual does, so those two labels only read correctly
         while Coin Mode is left at its default. -->
    <switches default="fe,bf" base="16">
        <!-- DSWA -->
        <dip name="Cabinet" bits="0" ids="Upright,Cocktail"/>
        <dip name="Flip Screen" bits="1" ids="On,Off"/>
        <dip name="Service Mode" bits="2" ids="On,Off"/>
        <dip name="Demo Sounds" bits="3" ids="Off,On"/>
        <dip name="Coin A" bits="4,5" ids="2C 3C,2C 1C,1C 2C,1C 1C"/>
        <dip name="Coin B" bits="6,7" ids="2C 3C,2C 1C,1C 2C,1C 1C"/>
        <!-- DSWB -->
        <dip name="Difficulty" bits="8,9" ids="Hardest,Hard,Easy,Medium"/>
        <dip name="Bonus Life" bits="10" ids="None,100k 1000k"/>
        <dip name="Complete Bonus" bits="11" ids="100k,1 Up"/>
        <dip name="Lives" bits="12,13" ids="2,1,4,3"/>
        <dip name="Language" bits="14" ids="English,Japanese"/>
        <dip name="Coin Mode" bits="15" ids="Mode B (World),Mode A (Japan)"/>
    </switches>

    <buttons names="Fire,Jump" default="0,1"/>
</misterromdescription>
