# ============================================================================
# Rbisland.qsf - Quartus project settings (skeleton)
#
# Target device matches the MiSTer main board: Cyclone V 5CEBA4F23C8
# (same part used by the official MiSTer_de10 top-level project).
# ============================================================================

# DE10-nano = Cyclone V SoC 5CSEBA6U23I7. The previous value here
# (5CEBA4F23C8) was a Cyclone V "E" part -- no HPS at all, so sys_top's
# HPS interface could never map to it, and it's also much smaller.
# It additionally caused "Error (21075): The junction temperature range
# value of '[0 C, 100 C]' is illegal", because that E part is a
# commercial-temp device (0-85 C) while the MiSTer framework sets the
# industrial 0-100 C range that 5CSEBA6U23I7 supports.
set_global_assignment -name MIN_CORE_JUNCTION_TEMP 0
set_global_assignment -name MAX_CORE_JUNCTION_TEMP 100
# Confirmed from the official MiSTer-devel wiki ("emu - Top Level of a
# MiSTer core"): sys_top.v (part of sys/) is the REAL physical top-level
# that Quartus should synthesize -- it handles board pin assignments and
# instantiates this project's own "emu" (Rbisland.sv) internally.
# Leaving this as "emu" (this project's own original placeholder, from
# before a real sys/ was ever available to confirm against) would
# attempt to synthesize "emu" directly against physical device pins,
# which won't work -- HPS_BUS and friends are meant to be wired
# internally by sys_top, not pin-assigned directly.
set_global_assignment -name TOP_LEVEL_ENTITY sys_top

set_global_assignment -name ORIGINAL_QUARTUS_VERSION 20.1.1
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files

# Quartus produces a .sof by default; MiSTer loads .rbf. Without this
# line the Assembler finishes successfully and you simply never get an
# .rbf -- which is exactly what happened on the first successful build.
set_global_assignment -name GENERATE_RBF_FILE ON
# Quartus warns when this isn't set and defaults conservatively. "ALL"
# lets it use every core available -- this design takes a while to
# compile (12+ minutes observed), so it's worth setting.
set_global_assignment -name NUM_PARALLEL_PROCESSORS ALL
set_global_assignment -name ERROR_CHECK_FREQUENCY_DIVISOR 1
# USE_CONFIGURATION_DEVICE / STRATIX_DEVICE_IO_STANDARD removed: neither
# appears in the working reference cores (meathax/s32, meathax/mrdo). The
# Cyclone V SoC on a DE10-nano is configured by the HPS, not by a serial
# configuration device, and a blanket default I/O standard can fight the
# per-pin standards that sys/sys.tcl assigns (SDRAM and HDMI pins need
# specific ones).
set_global_assignment -name CYCLONEII_RESERVE_NCEO_AFTER_CONFIGURATION "USE AS REGULAR IO"

