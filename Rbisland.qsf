# rtl/pll.sv is NOT in the project -- deliberately. A real Quartus-
# generated PLL IP (rtl/pll.v + rtl/pll/pll_0002.v) now provides module
# "pll", and MiSTer's sys_top REQUIRES CLK_VIDEO to come from genuine
# PLL hard-IP: its clock-select blocks reject anything else with
# "Error (15836): ... must be driven by a PLL's output clock". Our
# placeholder pll.sv is ordinary fabric logic, so it can never satisfy
# that, no matter how its frequencies are arranged.
#
# rtl/pll.sv is kept in the tree ONLY as (a) documentation of the exact
# M/N/C parameters the real IP should use (M=24, N=1, C0=25, C1=200 ->
# 48.000MHz/6.000MHz exactly from 50MHz) and (b) a frequency-accurate
# simulation model for Icarus testbenches, behind `define SIMULATION.
# Re-adding it here would both collide with the real IP's module name
# and reintroduce the sys_top clock-source error.
# set_global_assignment -name SYSTEMVERILOG_FILE rtl/pll.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/sdram_arbiter.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gfx_rom_loader.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pc080sn_layer_renderer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/gfx_read_arbiter2.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pc090oj_renderer.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/rbisland_cchip.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ika87ad/IKA87AD_mnemonics.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ika87ad/IKA87AD.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ika87ad/IKA87AD_microcode.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ika87ad/IKA87AD_opdec.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/ika87ad/IKA87AD_primitives.sv
set_global_assignment -name VERILOG_FILE rtl/ika87ad/jttc0030cmd.v
# High score NVRAM. Addresses come from MAME's hiscore.dat via
# rtl/game_config.svh; see the CFG_HS_* block there.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/hiscore_nvram.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/video.sv
set_global_assignment -name SYSTEMVERILOG_FILE rtl/audio_mixer.sv
# Pause supporter panel. Its font ROM is rtl/font8x8.hex, read by $readmemh at
# elaboration -- regenerate with `python tools/build_font.py` if the text or
# the glyphs change, because the font ships inside the .rbf.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/pause_overlay.sv
# High-score toast. Shares rtl/font8x8.hex with the pause panel. Unlike that
# module this one is drawn over a RUNNING game, so it touches only the video
# mux and never a clock enable.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/hs_toast.sv
# CRT Adjust -- rmonic79/MiSTer-CRT-Adjust, rtl/crt_adjust.sv from that repo,
# vendored verbatim (GPLv3, author Umberto Parisi). Core-side variant, so
# nothing under sys/ is modified. See the glue in Rbisland.sv.
set_global_assignment -name SYSTEMVERILOG_FILE rtl/crt/crt_adjust.sv

# fx68k.sv loads microrom.mem/nanorom.mem via relative-path $readmemb --
# add its directory to the search path so both Quartus synthesis and any
# simulator find them without copying them elsewhere.
set_global_assignment -name SEARCH_PATH rtl/fx68k
# rtl/ is on the search path so `include "game_config.svh"` resolves. Both
# rbisland_top.sv and rbisland_bus_decoder.sv include it for the per-game
# base-address table.
set_global_assignment -name SEARCH_PATH rtl
set_global_assignment -name SEARCH_PATH ./

# ---- MiSTer common framework: sys/sys.qip is the file that pulls in
# ---- EVERY framework source (hps_io.sv, sd_card.sv, the pll_cfg/
# ---- pll_hdmi/pll_audio stuff, etc) in one shot -- this line was left
# ---- commented out from this project's very first skeleton (before a
# ---- real sys/ ever existed to reference), and never got uncommented
# ---- again once real compilation actually started, which is exactly
# ---- why hps_io came back as "instantiates undefined entity": Quartus
# ---- was never told to look at sys/ at all. Uncommented now that a
# ---- real sys/ (copied from MiSTer-devel/Template_MiSTer) is expected
# ---- to be present alongside this project -- see sys/README.md.

set_global_assignment -name SDC_FILE Rbisland.sdc

# ============================================================================
# BOARD PIN ASSIGNMENTS -- THE FIX FOR "no signal"
# ============================================================================
# sys/sys.tcl and sys/sys_analog.tcl carry every DE10-nano pin location and
# I/O standard (HDMI, SDRAM, HPS, analog video, audio). They are TCL, not
# .qip, so they must be `source`d -- adding sys/sys.qip alone does NOT bring
# them in.
#
# Without these lines Quartus compiled cleanly (0 errors, timing met, .rbf
# produced) but reported:
#
#   Critical Warning (169085): No exact pin location assignment(s) for
#   145 pins of 145 total pins.
#
# ALL 145 I/O pins were then placed at arbitrary physical locations, so the
# HDMI transmitter, SDRAM and everything else were wired to whatever pins the
# fitter happened to pick. That is why the display showed "no signal" on both
# HDMI and CRT while the core itself was perfectly healthy internally -- the
# video was being generated correctly and sent to the wrong physical pins.
#
# Confirmed against meathax/s32 and meathax/mrdo: neither contains a single
# set_location_assignment, because both source these two scripts instead.
# Resource savers used by meathax/s32 -- this design fits, but not with
# much headroom, and neither feature is used here.
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_YC=1"
set_global_assignment -name VERILOG_MACRO "MISTER_DISABLE_ALSA=1"
# Framebuffer interface, required by screen rotation.
#
# DISABLED -- it breaks Direct Video on a real CRT.
#
# sys_top.v:295 derives `vga_fb = cfg[12] | vga_force_scaler`, and lines
# 1317-1320 route hs/vs/de/data from the Direct Video path ONLY while
# `~vga_fb`. Whenever the framebuffer is active the output falls back to the
# scaler instead, which emits the configured HDMI mode (640x480@60 here) --
# nothing a 15 kHz CRT can display. It presents as a black screen that flicks
# on and off as the framebuffer comes and goes, and takes the audio with it.
# meathax's Sega System 32 core, which works on that hardware, has this macro
# commented out in every one of its .qsf files and instantiates no
# screen_rotate at all.
#
# Turning it back on: uncomment this line. Rbisland.sv guards the FB_* ports,
# FB_FORCE_BLANK, the screen_rotate instance and the Rotation/Flip OSD entries
# behind the same macro, so nothing else has to change. sys_top.v:1790 wraps
# its FB_* connections in `ifdef MISTER_FB, so the macro and that port list
# must stay in step.
#set_global_assignment -name VERILOG_MACRO "MISTER_FB=1"

source sys/sys.tcl
